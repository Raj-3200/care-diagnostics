# ── Frontend Environment Variables ──
# Copy to .env.local and fill in your values

# API URL is not needed in browser — the Next.js proxy handles it via /api/*
# But if deploying without the proxy, set this:
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api/v1

# Backend URL for the Next.js server-side proxy (rewrite destination)
# In production: set this to your deployed backend URL
BACKEND_URL=https://your-backend.railway.app
